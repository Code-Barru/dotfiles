return {
  "nvim-neorg/neorg",
  lazy = false,
  version = "*",
  config = function()
    require("neorg").setup({
      load = {
        ["core.defaults"] = {},
        ["core.concealer"] = {
          config = {
            icon_preset = "diamond",
            folds = true,
            init_open_folds = "always",
            icons = {
              code_block = { conceal = true },
            },
          },
        },
        ["core.dirman"] = {
          config = {
            workspaces = {
              notes = "~/.sync/notes",
            },
            default_workspace = "notes",
            index = "index.norg",
          },
        },
        ["core.journal"] = {
          config = {
            workspace = "notes",
            journal_folder = "journal",
            strategy = "flat",
          },
        },
        ["core.qol.todo_items"] = {},
        ["core.ui.calendar"] = {},
        ["core.completion"] = {
          config = { engine = "nvim-cmp" },
        },
        ["core.integrations.nvim-cmp"] = {},
      },
    })
  end,
}
